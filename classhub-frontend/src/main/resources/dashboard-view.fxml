<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<!--
    Dashboard redesigned to match the screenshot:
    - Left sidebar: ClassHub logo, nav items (Dashboard, Smart Calendar, Assignments, Grades, Notes)
    - User footer with avatar initials, name, role, Settings + Logout buttons
    - Main area: "Dashboard" heading, 4 stat cards (GPA, Pending Tasks, Avg Grade, Attendance)
    - "My Classes" grid of 6 course cards
-->
<BorderPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="loginscreen.DashboardController"
            styleClass="root-pane"
            prefWidth="900" prefHeight="600">

    <!-- ===== LEFT SIDEBAR ===== -->
    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="0">

            <!-- Logo area -->
            <VBox styleClass="sidebar-logo-area" spacing="2">
                <padding><Insets top="24" left="20" right="20" bottom="16"/></padding>
                <Label text="ClassHub" styleClass="sidebar-logo"/>
                <Label text="STUDENT PORTAL" styleClass="sidebar-portal-label"/>
            </VBox>

            <!-- Nav section label -->
            <Label text="MAIN" styleClass="sidebar-section-label">
                <padding><Insets top="20" left="20" right="20" bottom="6"/></padding>
            </Label>

            <!-- Nav items -->
            <Button text="Dashboard" styleClass="nav-item,nav-item-active"
                    maxWidth="Infinity" onAction="#showDashboard"/>
            <Button text="Smart Calendar" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#showCalendar"/>
            <Button text="Assignments" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#showAssignments"/>
            <Button text="Grades" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#showGrades"/>
            <Button text="Notes" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#showNotes"/>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- User footer -->
            <VBox styleClass="sidebar-user-area" spacing="8">
                <padding><Insets top="12" left="12" right="12" bottom="16"/></padding>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="MF" styleClass="user-avatar"/>
                    <VBox spacing="1">
                        <Label fx:id="userNameLabel" text="Myles Freelin" styleClass="user-name"/>
                        <Label text="Student" styleClass="user-role"/>
                    </VBox>
                </HBox>

                <Button text="Settings" styleClass="sidebar-action-btn" maxWidth="Infinity"/>
                <Button text="Logout" styleClass="sidebar-logout-btn"
                        maxWidth="Infinity" onAction="#handleLogout"/>
            </VBox>

        </VBox>
    </left>

    <!-- ===== MAIN CONTENT ===== -->
    <center>
        <VBox styleClass="main-content" spacing="20">
            <padding><Insets top="28" left="28" right="28" bottom="28"/></padding>

            <!-- Page title -->
            <Label fx:id="sectionTitle" text="Dashboard" styleClass="page-title"/>

            <!-- Stat cards row -->
            <HBox spacing="14">

                <VBox styleClass="stat-card" spacing="6" prefWidth="140">
                    <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
                    <Label text="GPA" styleClass="stat-label"/>
                    <Label text="3.8" styleClass="stat-value-blue"/>
                </VBox>

                <VBox styleClass="stat-card" spacing="6" prefWidth="140">
                    <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
                    <Label text="Pending Tasks" styleClass="stat-label"/>
                    <Label text="6" styleClass="stat-value-red"/>
                </VBox>

                <VBox styleClass="stat-card" spacing="6" prefWidth="140">
                    <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
                    <Label text="Avg Grade" styleClass="stat-label"/>
                    <Label text="86%" styleClass="stat-value-green"/>
                </VBox>

                <VBox styleClass="stat-card" spacing="6" prefWidth="140">
                    <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
                    <Label text="Attendance" styleClass="stat-label"/>
                    <Label text="91%" styleClass="stat-value-yellow"/>
                </VBox>

            </HBox>

            <!-- My Classes section -->
            <VBox styleClass="classes-section" spacing="14">
                <padding><Insets top="18" left="18" right="18" bottom="18"/></padding>

                <Label text="My Classes" styleClass="section-heading"/>

                <!-- Row 1 -->
                <HBox spacing="14">
                    <VBox styleClass="class-card" spacing="4" prefWidth="240">
                        <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
                        <Label text="Calculus II" styleClass="class-name"/>
                        <Label text="MWF 9:00 AM" styleClass="class-time"/>
                    </VBox>
                    <VBox styleClass="class-card" spacing="4" prefWidth="240">
                        <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
                        <Label text="Data Structures" styleClass="class-name"/>
                        <Label text="TTH 10:30 AM" styleClass="class-time"/>
                    </VBox>
                </HBox>

                <!-- Row 2 -->
                <HBox spacing="14">
                    <VBox styleClass="class-card" spacing="4" prefWidth="240">
                        <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
                        <Label text="Physics I" styleClass="class-name"/>
                        <Label text="MWF 11:00 AM" styleClass="class-time"/>
                    </VBox>
                    <VBox styleClass="class-card" spacing="4" prefWidth="240">
                        <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
                        <Label text="English Composition" styleClass="class-name"/>
                        <Label text="TTH 1:00 PM" styleClass="class-time"/>
                    </VBox>
                </HBox>

                <!-- Row 3 -->
                <HBox spacing="14">
                    <VBox styleClass="class-card" spacing="4" prefWidth="240">
                        <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
                        <Label text="Chemistry Lab" styleClass="class-name"/>
                        <Label text="W 2:00 PM" styleClass="class-time"/>
                    </VBox>
                    <VBox styleClass="class-card" spacing="4" prefWidth="240">
                        <padding><Insets top="16" left="16" right="16" bottom="16"/></padding>
                        <Label text="World History" styleClass="class-name"/>
                        <Label text="MWF 2:00 PM" styleClass="class-time"/>
                    </VBox>
                </HBox>

            </VBox>

            <!-- Dynamic content area (for other views) -->
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS"/>

        </VBox>
    </center>

</BorderPane>
